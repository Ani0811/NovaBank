# NovaBank Configuration Example
# Copy to .env.local for local overrides (never commit real passwords)

NOVABANK_ENV=development
NOVABANK_APP_NAME=NovaBank
NOVABANK_DEBUG=true

# Database Connection (MySQL 8.0)
NOVABANK_DB_HOST=localhost
NOVABANK_DB_PORT=3306
NOVABANK_DB_USER=root
NOVABANK_DB_PASSWORD=
NOVABANK_DB_NAME=novabank_db

# Local AI Configuration (LM Studio)
NOVABANK_AI_ENABLED=true
NOVABANK_AI_BASE_URL=http://localhost:1234/v1
NOVABANK_AI_MODEL=llama-3.2-3b-instruct
NOVABANK_AI_TIMEOUT_SECONDS=10.0
