# NovaBank Configuration Example
# Copy to .env.local for local overrides (never commit real passwords)

BMS_ENV=development
BMS_APP_NAME=NovaBank
BMS_DEBUG=true

# Database Connection (MySQL 8.0)
BMS_DB_HOST=localhost
BMS_DB_PORT=3306
BMS_DB_USER=root
BMS_DB_PASSWORD=
BMS_DB_NAME=novabank_db

# Local AI Configuration (LM Studio)
BMS_AI_ENABLED=true
BMS_AI_BASE_URL=http://localhost:1234/v1
BMS_AI_MODEL=llama-3.2-3b-instruct
BMS_AI_TIMEOUT_SECONDS=10.0
