/* =========================================================================
   NovaBank Enterprise Fintech Design System
   Professional, Restrained, Trustworthy Institutional Banking Theme
   ========================================================================= */

* {
    font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, "Inter", sans-serif;
    font-size: 13px;
    color: #172033;
    outline: none;
}

QLabel {
    background-color: transparent;
    border: none;
}

QMainWindow, QWidget#CentralWidget, QStackedWidget#MainViewStack {
    background-color: #F5F7FA;
}

/* -------------------------------------------------------------------------
   Navigation Sidebar (Unified Light Fintech #FFFFFF)
   ------------------------------------------------------------------------- */
QFrame#SidebarFrame {
    background-color: #FFFFFF;
    border-right: 1px solid #E2E8F0;
    min-width: 240px;
    max-width: 240px;
}

QLabel#BrandTitle {
    font-size: 18px;
    font-weight: 700;
    color: #172033;
    letter-spacing: -0.3px;
}

QLabel#BrandSubtitle {
    font-size: 10px;
    font-weight: 600;
    color: #64748B;
    text-transform: uppercase;
    letter-spacing: 1.2px;
}

QLabel.NavSectionTitle {
    font-size: 11px;
    font-weight: 700;
    color: #94A3B8;
    letter-spacing: 0.8px;
    padding: 14px 18px 6px 18px;
    text-transform: uppercase;
}

QPushButton.NavButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    text-align: left;
    padding: 9px 14px;
    font-size: 13px;
    font-weight: 500;
    color: #475569;
    margin: 1px 10px;
}

QPushButton.NavButton:hover {
    background-color: #F1F5F9;
    color: #172033;
}

QPushButton.NavButton:checked, QPushButton.NavButton[active="true"] {
    background-color: #EFF6FF;
    color: #2563EB;
    font-weight: 600;
    border-left: 3px solid #2563EB;
}

QFrame#SidebarOperatorCard {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    margin: 10px 12px;
    padding: 8px 10px;
}

/* -------------------------------------------------------------------------
   Content Header Bar (Clean Surface #FFFFFF)
   ------------------------------------------------------------------------- */
QFrame#HeaderBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E2E8F0;
    min-height: 64px;
    max-height: 64px;
    padding: 0 28px;
}

QLabel#HeaderTitle {
    font-size: 20px;
    font-weight: 700;
    color: #172033;
}

QLabel#HeaderSubtitle {
    font-size: 13px;
    color: #64748B;
}

/* -------------------------------------------------------------------------
   Cards & Surface Containers (#FFFFFF with #E2E8F0 border)
   ------------------------------------------------------------------------- */
QFrame.CardFrame {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 20px;
}

QFrame.CardFrame:hover {
    border-color: #CBD5E1;
}

QLabel.CardTitle {
    font-size: 13px;
    font-weight: 600;
    color: #64748B;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QLabel.CardValue {
    font-size: 26px;
    font-weight: 700;
    color: #172033;
    font-feature-settings: "tnum";
}

QLabel.CardMuted {
    font-size: 12px;
    color: #64748B;
}

/* -------------------------------------------------------------------------
   Interactive Buttons
   ------------------------------------------------------------------------- */
QPushButton {
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 600;
    border: 1px solid transparent;
}

QPushButton.PrimaryButton {
    background-color: #2563EB;
    color: #FFFFFF;
    border: 1px solid #1D4ED8;
}

QPushButton.PrimaryButton:hover {
    background-color: #1D4ED8;
    border-color: #1E40AF;
}

QPushButton.PrimaryButton:pressed {
    background-color: #1E40AF;
}

QPushButton.PrimaryButton:disabled {
    background-color: #E2E8F0;
    color: #94A3B8;
    border-color: #CBD5E1;
}

QPushButton.SecondaryButton {
    background-color: #FFFFFF;
    color: #172033;
    border: 1px solid #CBD5E1;
}

QPushButton.SecondaryButton:hover {
    background-color: #F8FAFC;
    border-color: #94A3B8;
    color: #0F172A;
}

QPushButton.SecondaryButton:pressed {
    background-color: #F1F5F9;
}

QPushButton.SecondaryButton:disabled {
    background-color: #F8FAFC;
    color: #94A3B8;
    border-color: #E2E8F0;
}

QPushButton.SuccessButton {
    background-color: #15803D;
    color: #FFFFFF;
    border: 1px solid #166534;
}

QPushButton.SuccessButton:hover {
    background-color: #166534;
}

QPushButton.SuccessButton:disabled {
    background-color: #DCFCE7;
    color: #86EFAC;
    border-color: #BBF7D0;
}

QPushButton.DangerButton {
    background-color: #DC2626;
    color: #FFFFFF;
    border: 1px solid #B91C1C;
}

QPushButton.DangerButton:hover {
    background-color: #B91C1C;
}

QPushButton.DangerButton:disabled {
    background-color: #FEE2E2;
    color: #FCA5A5;
    border-color: #FECACA;
}

/* -------------------------------------------------------------------------
   Form Inputs: LineEdit, TextEdit, DateEdit, ComboBox
   ------------------------------------------------------------------------- */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 8px 12px;
    color: #172033;
    font-size: 13px;
    selection-background-color: #DBEAFE;
    selection-color: #172033;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #2563EB;
    background-color: #FFFFFF;
}

QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    background-color: #F8FAFC;
    color: #94A3B8;
    border-color: #E2E8F0;
}

QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 8px 12px;
    color: #172033;
    font-size: 13px;
    min-height: 20px;
}

QComboBox:focus {
    border: 1px solid #2563EB;
}

QComboBox:disabled {
    background-color: #F8FAFC;
    color: #94A3B8;
    border-color: #E2E8F0;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 26px;
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    color: #172033;
    selection-background-color: #EFF6FF;
    selection-color: #1D4ED8;
    padding: 4px;
}

QDateEdit {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 8px 12px;
    color: #172033;
    font-size: 13px;
}

QDateEdit:focus {
    border: 1px solid #2563EB;
}

QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 26px;
    border: none;
}

QCheckBox {
    font-size: 13px;
    color: #172033;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #CBD5E1;
    border-radius: 4px;
    background-color: #FFFFFF;
}

QCheckBox::indicator:hover {
    border-color: #2563EB;
}

QCheckBox::indicator:checked {
    background-color: #2563EB;
    border-color: #1D4ED8;
}

/* -------------------------------------------------------------------------
   Table Widgets & Headers
   ------------------------------------------------------------------------- */
QTableWidget, QTableView {
    background-color: #FFFFFF;
    alternate-background-color: #F8FAFC;
    gridline-color: transparent;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    color: #172033;
    font-size: 13px;
}

QTableWidget::item {
    padding: 10px 14px;
    border-bottom: 1px solid #F1F5F9;
}

QTableWidget::item:selected {
    background-color: #EFF6FF;
    color: #1E40AF;
}

QTableWidget::item:hover:!selected {
    background-color: #F8FAFC;
}

QHeaderView::section {
    background-color: #F8FAFC;
    color: #64748B;
    padding: 10px 14px;
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    border: none;
    border-bottom: 1px solid #E2E8F0;
}

/* -------------------------------------------------------------------------
   Tab Widget & Navigation Tabs
   ------------------------------------------------------------------------- */
QTabWidget::pane {
    border: 1px solid #E2E8F0;
    background-color: #FFFFFF;
    border-radius: 8px;
    top: -1px;
}

QTabBar::tab {
    background-color: #F1F5F9;
    color: #64748B;
    font-weight: 600;
    font-size: 13px;
    padding: 10px 22px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 4px;
    border: 1px solid #E2E8F0;
    border-bottom: none;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #2563EB;
    border-bottom: 2px solid #2563EB;
    font-weight: 700;
}

QTabBar::tab:hover:!selected {
    background-color: #E2E8F0;
    color: #172033;
}

/* -------------------------------------------------------------------------
   Modern Minimalist ScrollBars
   ------------------------------------------------------------------------- */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #CBD5E1;
    min-height: 28px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    border: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #CBD5E1;
    min-width: 28px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #94A3B8;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    border: none;
}

/* -------------------------------------------------------------------------
   Generic Status Indicator Badges (used in content headers & cards)
   ------------------------------------------------------------------------- */
QLabel.StatusIndicatorPill {
    background-color: #F1F5F9;
    border-radius: 12px;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: 600;
    color: #475569;
    border: 1px solid #E2E8F0;
}

QLabel.StatusIndicatorPill[status="success"] {
    color: #15803D;
    border: 1px solid #BBF7D0;
    background-color: #F0FDF4;
}

QLabel.StatusIndicatorPill[status="warning"] {
    color: #B45309;
    border: 1px solid #FDE68A;
    background-color: #FFFBEB;
}

QLabel.StatusIndicatorPill[status="danger"] {
    color: #DC2626;
    border: 1px solid #FECACA;
    background-color: #FEF2F2;
}

/* -------------------------------------------------------------------------
   Status Bar & Footer Telemetry
   ------------------------------------------------------------------------- */
QStatusBar#NovaStatusBar {
    background-color: #FFFFFF;
    border-top: 1px solid #E2E8F0;
    min-height: 28px;
    max-height: 28px;
    padding: 0 16px;
    color: #64748B;
    font-size: 11px;
}

QStatusBar#NovaStatusBar QLabel {
    background: transparent;
    border: none;
    font-size: 11px;
    color: #64748B;
}

QStatusBar#NovaStatusBar QLabel.StatusIndicatorPill {
    background-color: transparent;
    border: none;
    border-left: 1px solid #E2E8F0;
    border-radius: 0px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 500;
    color: #475569;
}

QStatusBar#NovaStatusBar QLabel.StatusIndicatorPill[status="success"] {
    color: #15803D;
    background-color: transparent;
    border-top: none;
    border-right: none;
    border-bottom: none;
    border-left: 1px solid #E2E8F0;
}

QStatusBar#NovaStatusBar QLabel.StatusIndicatorPill[status="warning"] {
    color: #B45309;
    background-color: transparent;
    border-top: none;
    border-right: none;
    border-bottom: none;
    border-left: 1px solid #E2E8F0;
}

QStatusBar#NovaStatusBar QLabel.StatusIndicatorPill[status="danger"] {
    color: #DC2626;
    background-color: transparent;
    border-top: none;
    border-right: none;
    border-bottom: none;
    border-left: 1px solid #E2E8F0;
}

QStatusBar#NovaStatusBar::item {
    border: none;
}

/* -------------------------------------------------------------------------
   Tooltips & Dialog Modals
   ------------------------------------------------------------------------- */
QToolTip {
    background-color: #101B2D;
    color: #FFFFFF;
    border: 1px solid #1E293B;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 12px;
}

QDialog, QMessageBox {
    background-color: #FFFFFF;
    color: #172033;
}
